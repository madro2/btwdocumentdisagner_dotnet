      },
      {
        "name": "InvcDtl",
        "cardinality": "zeroOrMany",
        "dataPath": "InvcDtl"
      },
      {
        "name": "SalesTRC",
        "cardinality": "zeroOrMany",
        "dataPath": "SalesTRC"
      },
      {
        "name": "DetailTaxScheme",
        "cardinality": "zeroOrOne",
        "dataPath": "DetailTaxScheme"
      },
      {
        "name": "Decimals",
        "cardinality": "zeroOrOne",
        "dataPath": "Decimals"
      }
